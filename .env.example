# ==============================================================================
# THE EARTH SCIENCE AUTOPILOT — ENVIRONMENT VARIABLES
# ==============================================================================
# Domain: spacegeoai.com
# Reference: NASA Space Apps Challenge 2026: Be An Earth System Trend Detective!
# Copy this file to .env.local and configure your personal credentials.
# Note: The application is designed to function with verified mock/reanalysis fallbacks
# if live API credentials are not provided.
# ==============================================================================

# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="The Earth Science Autopilot"
NEXT_PUBLIC_APP_TAGLINE="ASK THE EARTH — Search. Investigate. Discover."

# Supabase Authentication & Database
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"
NEXT_SUPABASE_PASSWORD="T1jXrhZjeqFXD2I0"

# NASA Earthdata Login & Discovery
# NASA CMR (Common Metadata Repository) public endpoints work without credentials.
# For NASA AppEEARS or Earthdata protected granules:
# Register at: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USERNAME=""
NASA_EARTHDATA_PASSWORD=""
NASA_EARTHDATA_CLIENT_ID=""
NASA_EARTHDATA_CLIENT_SECRET=""
NASA_EARTHDATA_REDIRECT_URI="http://localhost:3000/api/auth/callback/nasa"

# NOAA Climate Data Online (CDO) v2 API
# Request a free token at: https://www.ncei.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=""

# Geocoding / Location Search
# Optional: Nominatim (OpenStreetMap) default works without key.
# For LocationIQ, Mapbox, or Photon custom endpoints:
GEOCODING_API_KEY=""

# AI Provider for Natural Language Research Autopilot (Optional)
# Groq AI
AI_API_KEY=""

# Map Visualization Styles
# MapLibre default uses standard OpenStreetMap raster tiles; custom vector styles can be set here.
NEXT_PUBLIC_MAP_STYLE_URL="https://demotiles.maplibre.org/style.json"
